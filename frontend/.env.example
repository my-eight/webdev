# Указать настоящий HTTPS origin без пути перед публикацией.
NUXT_PUBLIC_SITE_URL=
# Включать только после подготовки домена, контактов и проверки релиза.
NUXT_PUBLIC_INDEXABLE=false
# Только согласованные публичные контакты. Пустое значение скрывает ссылку.
NUXT_PUBLIC_SLAVA_TELEGRAM=
NUXT_PUBLIC_SLAVA_EMAIL=
NUXT_PUBLIC_ERIN_TELEGRAM=
NUXT_PUBLIC_ERIN_EMAIL=
